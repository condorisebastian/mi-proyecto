rules_version = '2';

// Acceso por PIN sin Firebase Auth. La app crea una identidad anonima
// (signInAnonymously) al iniciar, por lo que las reglas exigen
// `request.auth != null`: sin la app/proyecto no hay acceso.
//
// El modelo de "puntos" requiere que la app lea, cree y (solo en `usuarios`)
// actualice el campo `puntos` del pasajero autenticado por PIN.
// Si se requiere seguridad real (duena unica de cada documento), migrar a
// Firebase Auth (correo/fono) y atar cada documento a su `uid`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // El centro de atención (call center) actualiza saldo, estado,
      // tipo y PIN; la app solo modifica el saldo de puntos.
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['puntos', 'estado', 'tipo', 'pin']);
      allow delete: if false;
    }
    match /conductores/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // El call center habilita/deshabilita y resetea el PIN del conductor.
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'pin']);
      allow delete: if false;
    }
    match /transacciones/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /incidencias/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}